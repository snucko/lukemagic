<div class="max-w-2xl mx-auto mb-8">
  <div class="relative">
    <input 
      type="text" 
      id="global-search" 
      placeholder="Search tricks, shows, articles..." 
      class="w-full px-4 py-3 rounded-lg bg-neutral-900 border border-neutral-800 text-white placeholder:text-neutral-500 focus:outline-none focus:border-magic-purple focus:ring-1 focus:ring-magic-purple"
    />
    <svg class="absolute right-4 top-3.5 w-5 h-5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>
  <div id="search-results" class="mt-6 grid md:grid-cols-2 gap-4"></div>
</div>

<script>
  interface SearchIndex {
    type: 'idea' | 'show';
    title: string;
    description?: string;
    slug: string;
  }

  let allResults: SearchIndex[] = [];

  async function initSearch() {
    try {
      const response = await fetch('/search.json');
      allResults = await response.json();
    } catch (error) {
      console.error('Failed to load search index:', error);
    }
  }

  function displayResults(results: SearchIndex[]) {
    const resultsDiv = document.getElementById('search-results');
    if (!resultsDiv) return;

    if (results.length === 0) {
      resultsDiv.innerHTML = '<p class="col-span-full text-center opacity-60">No results found</p>';
      return;
    }

    resultsDiv.innerHTML = results
      .slice(0, 8)
      .map(doc => {
        const typeLabel = doc.type === 'idea' ? '✨ Trick' : '🎭 Show';
        return `
          <div class="card p-4">
            <p class="text-xs font-bold text-magic-gold uppercase">${typeLabel}</p>
            <p class="font-bold font-serif text-lg mt-2">${doc.title}</p>
            ${doc.description ? `<p class="text-sm opacity-70 mt-2">${doc.description}</p>` : ''}
          </div>
        `;
      })
      .join('');
  }

  document.getElementById('global-search')?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value.trim().toLowerCase();

    if (!query || query.length < 2) {
      document.getElementById('search-results')!.innerHTML = '';
      return;
    }

    if (allResults.length === 0) {
      await initSearch();
    }

    const results = allResults.filter(doc =>
      doc.title.toLowerCase().includes(query) ||
      (doc.description ?? '').toLowerCase().includes(query)
    );
    displayResults(results);
  });

  // Initialize on load
  initSearch();
</script>
