---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PhotoSwipeGallery from "../components/PhotoSwipeGallery.astro";
import { readdir } from "node:fs/promises";
import { join } from "node:path";

let images: Array<{ src: string; alt: string }> = [];

try {
   const galleryPath = join(process.cwd(), "public", "media", "gallery");
   const files = await readdir(galleryPath);
   images = files
     .filter(file => /\.(png|jpe?g|gif|webp)$/i.test(file))
     .sort()
     .map((file, index) => {
       const row = Math.floor(index / 3) + 1;
       const col = (index % 3) + 1;
       return {
         src: `/media/gallery/${file}`,
         alt: `Luke performing magic - Gallery image ${row}-${col}`
       };
     });
 } catch (error) {
   console.warn("Could not load gallery images:", error);
 }

// Hand-picked videos that play right on the page. (7564158445734071607 was removed on TikTok.)
const tiktokVideos = ['7561588816000175415', '7550841538868202807'];
---
<Base title="Gallery — Luke" description="Photo gallery of Luke's magic performances and show highlights.">
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "Gallery" }
  ]} />
  <section class="max-w-6xl mx-auto px-6 py-10">
    <!-- TikTok's standard embed script is broken for US visitors (its library 404s and Chrome
         blocks it), so use TikTok's iframes directly. -->
    <h2 class="text-2xl mb-4">Latest on TikTok</h2>
    <!-- TikTok's creator embed: always shows his newest videos, nothing to update here. -->
    <iframe
      src="https://www.tiktok.com/embed/@cequity"
      title="Luke's latest TikTok videos"
      class="w-full max-w-3xl mx-auto block rounded-lg border-0 bg-white mb-10"
      height="480"
      allow="encrypted-media; fullscreen"
      loading="lazy"
    ></iframe>
    <h2 class="text-2xl mb-4">Featured</h2>
    <div class="flex flex-wrap justify-center gap-6 mb-10">
      {tiktokVideos.map((id) => (
        <iframe
          src={`https://www.tiktok.com/player/v1/${id}?music_info=1&description=1`}
          title="Luke on TikTok"
          width="325"
          height="578"
          class="max-w-full rounded-lg border-0"
          allow="encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      ))}
    </div>
    <h2 class="text-2xl mb-4">Gallery</h2>
    <PhotoSwipeGallery images={images} columns={3} />
  </section>
</Base>